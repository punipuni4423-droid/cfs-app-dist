# Default: each PC keeps project data locally.
CFS_SHARING_MODE=local

# Secure shared mode: only these public values may be copied to another PC.
# CFS_SHARING_MODE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# CFS_SUPABASE_FUNCTION_NAME=cfs-api

# Microsoft Entra sign-in is configured in Supabase Auth with the Azure provider.
# Do not put the Entra client secret in this file or in a distributed CFS folder.

# Function-only secrets/settings are listed here only as Supabase Dashboard
# reminders. Do not set these in distributed CFS env files.
# CFS_REQUIRED_AUTH_PROVIDER=azure
# CFS_ENTRA_TENANT_ID=<tenant-guid>
# CFS_ALLOWED_EMAIL_DOMAINS=example.com
# CFS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Never put SUPABASE_SERVICE_ROLE_KEY in a distributed CFS folder, ZIP file,
# browser configuration, or Git repository. It belongs only in Supabase Function secrets.
